MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/kananhub?appName=Cluster0
PORT=5000
JWT_SECRET=change_me
CLIENT_ORIGIN=http://localhost:5173

# Email (welcome/verification emails). Leave unset to fall back to console-logging the email instead of sending it.
# Gmail SMTP: SMTP_USER = your Gmail address, SMTP_PASS = a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords; requires 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kanan HR" <your-gmail@gmail.com>
